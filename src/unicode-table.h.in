/**
##header
 */

#pragma once

#ifdef __cplusplus
extern "C" {
#endif

#include <stddef.h>
#include <stdint.h>

/**
 * Maximum allowed Unicode value.
 */
#define {c:MAX_VALUE} 0x10FFFF

{if:flags}
/**
 * Flags for determining character type.
 */
typedef enum {
	{c:FlagLetter}       = 1 << 0,  ///< Is letter.
	{c:FlagUppercase}    = 1 << 1,  ///< Is uppercase letter.
	{c:FlagLowercase}    = 1 << 2,  ///< Is lowercase letter.
	{c:FlagTitlecase}    = 1 << 3,  ///< Is titlecase letter.
	{c:FlagSpace}        = 1 << 4,  ///< Is space character.
	{c:FlagLinebreak}    = 1 << 5,  ///< Is linebreak.
	{c:FlagPunctuation}  = 1 << 6,  ///< Is punctuation character.
	{c:FlagDigit}        = 1 << 7,  ///< Is digit character.
	{c:FlagNumber}       = 1 << 8,  ///< Is number character.
	{c:FlagFraction}     = 1 << 9,  ///< Is fraction character.
	{c:FlagControl}      = 1 << 10, ///< Is control character.
	{c:FlagSymbol}       = 1 << 11, ///< Is symbol.
	{c:FlagOther}        = 1 << 12, ///< Other character.
	{c:FlagUpperExpands} = 1 << 13, ///< Uppercase expands to multiple characters.
	{c:FlagLowerExpands} = 1 << 14, ///< Lowercase expands to multiple characters.
	{c:FlagTitleExpands} = 1 << 15, ///< Titlecase expands to multiple characters.
	{c:FlagCaseExpands} = {c:FlagUpperExpands} | {c:FlagLowerExpands} | {c:FlagTitleExpands}, ///< Some case expands to multiple characters.
} {n:Flag};
{endif:}

{if:categories}
/**
 * Character categories.
 */
typedef enum {
##categories
} {n:Category};
{endif:}

{if:casing}
/**
 * Case variant index usable for `cases` field in `UTInfo`.
 */
typedef enum {
	{c:CaseUpper} = 0, ///< Index for uppercase variant.
	{c:CaseLower} = 1, ///< Index for lowercase variant.
	{c:CaseTitle} = 2, ///< Index for titlecase variant.
} {n:Case};
{endif:}

/**
 * A Unicode character value.
 */
typedef uint32_t {n:Glyph};

/**
 * Character info.
 */
typedef struct {
{if:flags}
	uint16_t flags; ///< Combination of `{n:Flag}`.
{endif:}
{if:categories}
	uint8_t category; ///< One of `{n:Category}`.
{endif:}
{if:casing}
	int32_t cases[3]; ///< Distance to case variant. Indexable with `{n:Case}`.
{endif:}
{if:numbers}
	union {
		int64_t number; ///< Number value if `flags & {c:FlagNumber}`.
		struct {
			int32_t numerator; ///< Fraction numerator if `flags & {c:FlagFraction}`.
			int32_t denominator; ///< Fraction denominator if `flags & {c:FlagFraction}`.
		};
	};
{endif:}
} {n:Info};

{if:casing}
/**
 * Helper struct for reading special case-folding sequences in `{n:SpecialCases}`.
 */
typedef struct {
	{n:Glyph} count; ///< Number of characters.
	{n:Glyph} glyphs[]; ///< Sequence of characters.
} {n:SpecialCase};
{endif:}

/**
 * Table sizes.
 */
#define {c:InfoTableSize} {v:infoTableSize}
#define {c:PageIndexTableSize} {v:pageIndexTableSize}
#define {c:InfoIndexTableSize} {v:infoIndexTableSize}
#define {c:SpecialCasesTableSize} {v:specialCasesTableSize}
#define {c:CategoryNamesTableSize} {v:categoryNamesTableSize}

/**
 * Character information indexable with values from `{n:InfoIndex}`.
 */
extern {n:Info} const {n:Infos}[{c:InfoTableSize}];

/**
 * All Unicode pages.
 * Points to entry in `{n:InfoIndex}`.
 */
extern {v:pagesType} const {n:PageIndex}[{c:PageIndexTableSize}];

/**
 * Indices of `{n:Infos}`.
 * `{n:InfoIndex}[page index][index in page]`.
 */
extern {v:infoType} const {n:InfoIndex}[{c:InfoIndexTableSize}][256];

{if:casing}
/**
 * Special case-folding sequences.
 * A list of `{n:SpecialCase}` with variable number of `glyphs`.
 */
extern {n:Glyph} const {n:SpecialCases}[{c:SpecialCasesTableSize}];
{endif:}

{if:categories}
/**
 * Category name indexable with `{n:Category}`.
 */
extern char const* const {n:CategoryNames}[{c:CategoryNamesTableSize}];
{endif:}

/**
 * Lookup character by value.
 *
 * @param glyph A Unicode character value.
 * @return Character info.
 */
static inline {n:Info} const* {n:LookupGlyph}({n:Glyph} glyph) {
	if (glyph > {c:MAX_VALUE}) {
		glyph = 0; // Map glyph to invalid category.
	}

	const {v:pagesType} page = {n:PageIndex}[glyph >> 8];
	const {v:infoType} offset = {n:InfoIndex}[page][glyph & 0xFF];

	return &{n:Infos}[offset];
}

{if:casing}
/**
 * Get special case-folding sequence of character.
 *
 * @param info Character information of @p glyph.
 * @param variant Case variant.
 * @return Case-folding sequence or `NULL` if none exists for given case variant.
 */
static inline {n:SpecialCase} const* {n:GetSpecialCase}({n:Info} const* info, {n:Case} variant) {
	uint32_t offset = 0;

	if (info->flags & {c:FlagCaseExpands} & ({c:FlagUpperExpands} << variant)) {
		offset = info->cases[variant];
	}

	return ({n:SpecialCase} const*) &{n:SpecialCases}[offset];
}
{endif:}

/**
 * Get minimum valid glyph value for UTF-8 sequence with @p length continuation bytes.
 *
 * @param length Number of UTF-8 continuation bytes.
 * @return Minimum valid glyph value.
 */
static inline {n:Glyph} {n:MinValidGlyph}(uint32_t length) {
	/**
	 * Minimum valid range for sequence sizes. Value is expressed as shift.
	 *
	 * ```
	 * 0XXXXXXX                                               (0 << 0)
	 * 110XXXXX 10XXXXXX                                      (1 << 7)
	 * 1110XXXX 10XXXXXX 10XXXXXX                             (1 << 11)
	 * 11110XXX 10XXXXXX 10XXXXXX 10XXXXXX                    (1 << 16)
	 * 111110XX 10XXXXXX 10XXXXXX 10XXXXXX 10XXXXXX           (1 << 21)
	 * 1111110X 10XXXXXX 10XXXXXX 10XXXXXX 10XXXXXX 10XXXXXX  (1 << 26)
	 * ```
	 */
	static uint32_t const ranges =
		(7U << 5) |
		(11U << 10) |
		(16U << 15) |
		(21U << 20) |
		(26U << 25);

	return (1U << ((ranges >> (length * 5)) & 0x1F)) - 1;
}

#ifdef __cplusplus
}
#endif
